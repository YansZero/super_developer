# Jira 公開設定；請由使用者自行填入，勿貼到聊天。
# 此檔僅供 npm run jira:config:check 使用；尚未啟動 BFF/OAuth/SQLite。
ATLASSIAN_CLIENT_ID=
# 此 callback 端點尚未實作；目前固定規劃路徑 /auth/jira/callback。
ATLASSIAN_CALLBACK_URL=http://localhost:4318/auth/jira/callback
ATLASSIAN_SCOPES=read:me read:jira-work offline_access
FRONTEND_URL=http://localhost:5173
SD_BFF_PORT=4318
SD_DATABASE_PATH=./backend/data/super-developer.sqlite

# 未來 BFF 機密欄位：留空，不使用 VITE_ 前綴；本檢查工具不讀取其值。
ATLASSIAN_CLIENT_SECRET=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
