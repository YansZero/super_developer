{
  "name": "super-developer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "agent": "node local-agent/server.mjs",
    "build": "tsc -b && vite build && npm run bff:build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && npm --prefix backend run typecheck",
    "jira:config:check": "node --env-file-if-exists=backend/.env scripts/checkJiraConfig.mjs",
    "env:init": "node scripts/initEnv.mjs",
    "mcp:setup": "node scripts/setupMcpTools.mjs",
    "setup": "node scripts/initEnv.mjs && npm run bff:install && npm run renew && npm run mcp:setup",
    "renew": "node scripts/renewSecrets.mjs",
    "dev:frontend": "vite",
    "dev:bff": "npm run bff:build && node --env-file-if-exists=backend/.env backend/dist/backend/src/server.js",
    "dev:all": "node scripts/dev.mjs",
    "bff:install": "npm --prefix backend ci",
    "bff:build": "npm --prefix backend run build",
    "bff:start": "node --env-file-if-exists=backend/.env backend/dist/backend/src/server.js"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.6.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "sass": "^1.107.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  },
  "overrides": {
    "browserslist": "4.29.0"
  }
}
